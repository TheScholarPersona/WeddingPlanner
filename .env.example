# Copy to .env (`make setup` does this). Local development values only — never real secrets.

POSTGRES_USER=wedding_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=weddingplanner
APP_DB_PASSWORD=change-me-app
ADMIN_DB_PASSWORD=change-me-admin

S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=change-me-storage
S3_BUCKET=documents

# Virus scan of uploaded documents: "off" (local default) or "clamav" (needs the scan profile:
# `docker compose --profile scan up -d`). Production always requires "clamav".
VIRUS_SCAN=off

LOG_LEVEL=INFO

# Reachability from phones in the same Wi-Fi: set by `make lan`, removed by `make lan-off`.
# SITE_ADDRESS=localhost, my-mac.local
# APP_BASE_URL=https://my-mac.local
# LAN_HOST=my-mac.local
